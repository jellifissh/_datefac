{
  "schema_version": "r7bl_persistence_contract_fixture_v1",
  "fixture_scope": "test_only_r7bl",
  "valid_cases": {
    "valid_schema_alignment_preview_mixed_records": {
      "r7bi_case": "valid_mixed_review_records",
      "expected_candidate_count": 2,
      "expected_statuses": [
        "DISAGREED",
        "AMBIGUOUS"
      ]
    },
    "valid_unresolved_blocked_delivery_record": {
      "r7bi_case": "valid_unresolved_blocked_delivery",
      "expected_candidate_count": 1,
      "expected_statuses": [
        "PARSE_SKIPPED"
      ]
    },
    "valid_corrected_reaudit_required_record": {
      "r7bi_case": "valid_mixed_review_records",
      "mutation": {
        "action": "set_many",
        "record_index": 0,
        "values": {
          "review_status": "CORRECTED",
          "reviewer_action": "CORRECT_VALUE",
          "re_audit_required": true,
          "blocked_delivery_reason": "corrected_value_requires_reaudit_before_clean_delivery"
        }
      },
      "expected_candidate_count": 2,
      "expected_corrected_record_count": 1
    }
  },
  "negative_cases": [
    {
      "case_id": "invalid_default_disabled",
      "expected_error": "disabled_by_default"
    },
    {
      "case_id": "invalid_missing_test_persistence_flag",
      "expected_error": "test-only persistence enable token"
    },
    {
      "case_id": "invalid_schema_alignment_bypass",
      "payload_kind": "minimal_schema_like",
      "expected_error": "required fields"
    },
    {
      "case_id": "invalid_direct_dry_run_integration_output",
      "payload_kind": "dry_run_integration_output",
      "expected_error": "forbidden field"
    },
