      "mutation": {
        "action": "set_many_paths",
        "values": {
          "input_file_hashes": {},
          "future_review_queue_record_previews.0.source_file_hash": ""
        }
      },
      "expected_error": "input_file_hashes"
    },
    {
      "case_id": "non_string_metric_name",
      "mutation": {
        "action": "set",
        "path": "future_review_queue_record_previews.0.metric_name",
        "value": [
          "YoY"
        ]
      },
      "refresh_schema_hash": true,
      "expected_error": "metric_name must be a string"
    },
    {
      "case_id": "non_string_period",
      "mutation": {
        "action": "set",
        "path": "future_review_queue_record_previews.0.period",
        "value": 2026
      },
      "refresh_schema_hash": true,
      "expected_error": "period must be a string"
    },
    {
      "case_id": "nan_candidate_value",
      "mutation": {
        "action": "set_many",
        "record_index": 0,
        "values": {
          "candidate_value": "NaN",
          "normalized_candidate_value": "NaN"
        }
      },
      "refresh_schema_hash": true,
      "expected_error": "NaN or Infinity"
    },
    {
      "case_id": "infinity_candidate_value",
      "mutation": {
        "action": "set_many",
        "record_index": 0,
        "values": {
          "candidate_value": "Infinity",
          "normalized_candidate_value": "Infinity"
        }
      },
      "refresh_schema_hash": true,
      "expected_error": "NaN or Infinity"
    },
    {
      "case_id": "unexpected_persistence_destination",
      "mutation": {
        "action": "set",
        "path": "persistence_destination",
        "value": "database"
      },
      "expected_error": "forbidden field"
    },
    {
      "case_id": "unexpected_table_name",
      "mutation": {
        "action": "set",
        "path": "table_name",
        "value": "review_queue"
      },
      "expected_error": "forbidden field"
    },
    {
      "case_id": "database_dsn_path_output_path",
      "mutation": {
        "action": "set_many_paths",
