{
  "schema_version": "r7bm_persistence_contract_negative_path_fixture_v1",
  "fixture_scope": "test_only_r7bm",
  "base_case": "valid_schema_alignment_preview_mixed_records",
  "negative_cases": [
    {
      "case_id": "missing_trusted_schema_alignment_marker",
      "mutation": {
        "action": "delete",
        "path": "schema_alignment_summary.schema_alignment_preview_hash"
      },
      "expected_error": "schema_alignment_preview_hash"
    },
    {
      "case_id": "wrong_schema_alignment_contract_version",
      "mutation": {
        "action": "set",
        "path": "schema_alignment_contract_version",
        "value": "wrong_contract_version"
      },
      "expected_error": "contract version"
    },
    {
      "case_id": "wrong_future_review_queue_schema_version",
      "mutation": {
        "action": "set",
        "path": "future_review_queue_schema_version",
        "value": "wrong_schema_version"
      },
      "expected_error": "schema version"
    },
    {
      "case_id": "mixed_trusted_untrusted_rows",
      "mutation": {
        "action": "set",
        "path": "future_review_queue_record_previews.1.agreement_status",
        "value": "VERIFIED"
      },
      "refresh_schema_hash": true,
      "expected_error": "non-VERIFIED"
    },
    {
      "case_id": "one_valid_one_invalid_row_fails_batch",
      "mutation": {
        "action": "set",
        "path": "future_review_queue_record_previews.1.source_file_hash",
        "value": ""
      },
      "refresh_schema_hash": true,
      "expected_error": "source_file_hash"
    },
    {
      "case_id": "nested_full_source_text_under_evidence_preview",
      "mutation": {
        "action": "set",
        "path": "future_review_queue_record_previews.0.evidence_preview",
        "value": {
          "preview": "bounded",
          "source_text": "forbidden full source text"
        }
      },
      "expected_error": "forbidden field"
    },
    {
      "case_id": "nested_raw_mineru_under_source_trace",
      "mutation": {
        "action": "set",
        "path": "future_review_queue_record_previews.0.source_trace.raw_mineru",
        "value": {
          "block": "raw"
        }
      },
      "expected_error": "forbidden field"
    },
    {
      "case_id": "nested_raw_excel_under_metadata",
