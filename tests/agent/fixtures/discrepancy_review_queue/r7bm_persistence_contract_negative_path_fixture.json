    },
    {
      "case_id": "hidden_readiness_override",
      "mutation": {
        "action": "set",
        "path": "metadata.readiness.production_ready",
        "value": true
      },
      "expected_error": "readiness gate"
    },
    {
      "case_id": "test_only_token_leaks_into_candidate_row",
      "mutation": {
        "action": "set",
